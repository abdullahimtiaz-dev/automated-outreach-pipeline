    {
      "parameters": {
        "promptType": "define",
        "text": "=Brand: {{ $json[\"Brand Name\"] }}\nNiche: {{ $json[\"Niche\"] }}\nWebsite: {{ $json[\"Website / Instagram Link\"] }}\nCity: {{ $json[\"City\"] }}\nObserved Opportunity: {{ $json[\"Observed Opportunity\"] }}",
        "needsFallback": true,
        "messages": {
          "messageValues": [
            {
              "message": "Write short, human cold emails for Alex, an AI & workflow automation builder targeting Pakistani businesses.\n\nGoal: start a genuine conversation about automating repetitive business work. Do not hard-sell.\n\nSTYLE\n- Human, humble, conversational.\n- Sound like one person, not an agency.\n- Simple English.\n- 70–110 words for BODY.\n- No hype, buzzwords, generic praise, or exaggerated claims.\n\nPOSITIONING\nAlex builds AI and workflow automations that reduce repetitive manual work, save time, reduce errors, and improve day-to-day operations.\n\nPERSONALIZATION\nUse the provided business information naturally.\nTreat \"Observed Opportunity\" as a hypothesis, not a confirmed internal problem.\nUse it as a relevant angle, but keep the pitch open to other automation opportunities.\nNever invent company facts, systems, tools, problems, clients, results, or savings.\n\nDo not say:\n- \"I noticed you have a problem\"\n- \"I know your process\"\n- \"I can save X hours/money\"\n- anything implying confirmed internal knowledge\n\nAvoid mentioning n8n, Upwork, GitHub, freelancing, or technical jargon.\n\nGREETING/SIGNATURE\nDo NOT write a greeting.\nDo NOT write a sign-off or signature.\nDo NOT start BODY with Hi, Hello, Hey, Dear, etc.\nDo NOT end BODY with Best, Thanks, Regards, Alex, or similar.\nEdit Fields adds these later.\n\nSUBJECT\n- 3–7 words.\n- Natural and relevant.\n- Curiosity-driven, not clickbait.\n- Never use \"Business Proposal\" or \"AI Automation Services\".\n\nOUTPUT\nReturn exactly two lines:\n\nSUBJECT: [subject]\nBODY: [body only]"
            }
          ]
        }
      },
      "id": "db77806a-818c-4c4a-9a05-445e76393051",
      "name": "Basic LLM Chain - Opener",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        672,
        -32
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "b1-0001",
              "name": "subject",
              "type": "string",
              "value": "={{ $json.text.match(/SUBJECT:\\s*(.*)/)?.[1]?.trim() || \"A quick idea for \" + $('Limit (Batch of 5)').item.json[\"Brand Name\"] }}"
            },
            {
              "id": "b1-0002",
              "name": "body",
              "type": "string",
              "value": "=Hi {{ $('Limit (Batch of 5)').item.json[\"Contact Person\"] || \"there\" }},\n\n{{ $json.text.match(/BODY:\\s*([\\s\\S]*)/)?.[1]?.trim() || \"\" }}\n\nBest Regards,\nAlex Morgan\nAI & Workflow Automation\nLinkedin: https://www.linkedin.com/in/yourprofile"
            },
            {
              "id": "b1-0003",
              "name": "to_email",
              "type": "string",
              "value": "={{ $('Limit (Batch of 5)').item.json[\"Email\"] }}"
            },
            {
              "id": "b1-0004",
              "name": "row_number",
              "type": "number",
              "value": "={{ $('Limit (Batch of 5)').item.json[\"row_number\"] }}"
            }
          ]
        },
        "options": {}
      },
