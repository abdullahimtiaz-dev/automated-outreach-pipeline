        "jsCode": "const sheetRow = $('Google Sheets - Read Due Followups').item.json;\nconst threadMsgs = $('Gmail - Get Thread').item.json.messages;\nconst lastMsg = threadMsgs[threadMsgs.length - 1];\n\nfunction getHeader(msg, name) {\n  const key = Object.keys(msg).find(k => k.toLowerCase() === name.toLowerCase());\n  return key ? msg[key] : undefined;\n}\n\nconst toEmail = sheetRow['Email'];\nconst fromEmail = 'your.email@gmail.com';\n\n// Pull the REAL original subject instead of rebuilding from Brand Name\nconst originalSubject = getHeader(lastMsg, 'Subject') || sheetRow['Brand Name'];\nconst subject = originalSubject.toLowerCase().startsWith('re:')\n  ? originalSubject\n  : 'Re: ' + originalSubject;\n\nconst body = $('Set - Build Follow-up Template').item.json.draft_body;\nconst originalMessageId = getHeader(lastMsg, 'Message-ID');\n\nif (!originalMessageId) {\n  throw new Error('Message-ID not found. Keys available: ' + Object.keys(lastMsg).join(', '));\n}\nif (!body) {\n  throw new Error('draft_body is empty — check Set node output');\n}\n\nconst rawLines = [\n  'From: ' + fromEmail,\n  'To: ' + toEmail,\n  'Subject: ' + subject,\n  'In-Reply-To: ' + originalMessageId,\n  'References: ' + originalMessageId,\n  'MIME-Version: 1.0',\n  'Content-Type: text/plain; charset=\"UTF-8\"',\n  '',\n  body\n];\n\nconst raw = rawLines.join('\\r\\n');\nlet b64 = Buffer.from(raw, 'utf-8').toString('base64');\nb64 = b64.replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');\n\nreturn [{\n  json: { rawEncoded: b64, threadId: sheetRow['THREAD ID'] }\n}];"
      },
